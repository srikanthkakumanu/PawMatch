{
  "mcpServers": {
    "policy-rag": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python",
        "3.12",
        "--with",
        "mcp>=2,<3",
        "python",
        "./tools/policy-rag-server/server.py"
      ],
      "env": {
        "POLICY_DIR": "./policies"
      }
    }
  }
}
